-- Q3: Create an Employee table with columns EmpID, Name, Department, City, Salary 

create table employee(
	Emp_ID int,
    Name varchar(20),
    Department varchar(30),
    City varchar(30),
    Salary decimal(15,2)
    
    );
    
    show tables;
    
    describe employee;
    
